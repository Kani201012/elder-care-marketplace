# Copy this file to .env and fill in real values before running the server.

# Port the server listens on
PORT=3000

# A long, random string used to sign admin login sessions.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# The admin account you (the founder) will log in with to vet caregivers
# and create matches. Run "npm run seed-admin" after setting these to
# create the account in the database.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password
